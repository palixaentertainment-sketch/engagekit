{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" }
  ]
}
